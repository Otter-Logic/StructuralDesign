<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OtterLogic.Clustering</RootNamespace>
    <AssemblyName>OtterLogic.Clustering</AssemblyName>
    <!-- A toolkit: the end product built on the MachineLearning engine. No UI,
         no Grasshopper, and no dependency on any sibling toolkit.

         The repo is Clustering_Tool and the project inside it is
         OtterLogic.Clustering, following Document_Tool - the folder name is the
         odd one out, not the assembly. Everywhere a user sees it, in the
         Grasshopper ribbon and in the Rhino panel, the section is
         "Clustering". -->

    <IsPackable>true</IsPackable>
    <PackageId>OtterLogic.Clustering</PackageId>
    <Description>Clustering that chooses its own model - k-means, Gaussian mixture or HDBSCAN - from the evidence in the data. Built on OtterLogic.MachineLearning, and tuned for structural analysis results.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Otter-Logic/Clustering_Tool</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Otter-Logic/Clustering_Tool</RepositoryUrl>
    <PackageTags>rhino;rhino3d;grasshopper;computational-design;machine-learning;clustering;structural</PackageTags>

  </PropertyGroup>

  <!-- No package references of its own. Everything numerical comes from
       MachineLearning, which carries none either. -->

  <!-- A sibling checkout wins; the published package is the fallback. Clone the
       repos side by side and the inner loop is unchanged; CI has no siblings, so
       it builds against the published packages. -->
  <Choose>
    <When Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\Core\src\OtterLogic.Core\OtterLogic.Core.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\..\..\Core\src\OtterLogic.Core\OtterLogic.Core.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="OtterLogic.Core" Version="[$(Version)]" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <Choose>
    <When Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\MachineLearning\src\OtterLogic.MachineLearning\OtterLogic.MachineLearning.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\..\..\MachineLearning\src\OtterLogic.MachineLearning\OtterLogic.MachineLearning.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="OtterLogic.MachineLearning" Version="[$(Version)]" />
      </ItemGroup>
    </Otherwise>
  </Choose>

</Project>
